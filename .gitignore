# ==========================================================
# C++ & Visual Studio 최적화 설정
# ==========================================================

# --- Visual Studio 임시/설정 파일 ---
.vs/                   # VS 설정 및 캐시 (가장 중요)
Debug/                 # 디버그 빌드 결과물
Release/               # 릴리즈 빌드 결과물
x64/                   # 64비트 빌드 결과물
x86/                   # 32비트 빌드 결과물
out/                   # CMake 등 빌드 출력
[Bb]in/                # 일반적인 바이너리 폴더
[Oo]bj/                # 중간 생성 객체 폴더

# --- 컴파일 결과물 (Binary) ---
*.exe
*.dll
*.lib
*.ilk
*.exp
*.obj
*.pch
*.gch
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate

# --- 게임 엔진 특화 (Shader 컴파일 등) ---
*.gmcache
*.aps

# --- 사용자 설정 파일 (개인마다 다름) ---
*.suo
*.userosscache
*.sln.docstates

# ==========================================================
# 프로젝트 전용 제외 설정
# ==========================================================

# 요청하신 특정 애셋 폴더 제외
# (경로가 Binary/Asset/Texture/ 가 맞는지 확인하세요)
Binary/Asset/Texture/

# ==========================================================
# 기타/OS 설정
# ==========================================================
Thumbs.db
desktop.ini
*.log
*.tmp

Obj/
*.mine
*.r[0-9]*

*.cso
*.txt

# --- SVN 관련 파일 차단 ---
.svn/
*.mine
*.r[0-9]*
*.svn-base
/.vs
